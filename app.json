{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "scheme": "tether",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7cd8d851-0a11-4d82-aa4c-72a7cfcc8cfa",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tether uses your photos so you can share daily moments with your partner.",
          "cameraPermission": "Tether uses your camera to capture daily moments and to power the Lens, so you can see exactly which way your partner is."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8638C",
          "sounds": ["./assets/alarm.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tether uses your camera to capture daily moments and to power the Lens, so you can see exactly which way your partner is.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tether uses your location to point the compass toward your partner and measure the distance between you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Tether uses motion & fitness data to count your steps, so every walk quietly brings you closer to your partner."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tether.app"
    },
    "android": {
      "package": "com.tether.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#B22F49",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "piyushkhadse",
    "extra": {
      "eas": {
        "projectId": "7cd8d851-0a11-4d82-aa4c-72a7cfcc8cfa"
      }
    }
  }
}
