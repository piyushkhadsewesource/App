{
  "expo": {
    "name": "Tether",
    "slug": "tether",
    "scheme": "tether",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tether uses your photos so you can share daily moments with your partner.",
          "cameraPermission": "Tether uses your camera to capture daily moments to share with your partner."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8638C",
          "sounds": ["./assets/alarm.wav"]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tether.app"
    },
    "android": {
      "package": "com.tether.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "piyushkhadse",
    "extra": {
      "eas": {
        "projectId": "7cd8d851-0a11-4d82-aa4c-72a7cfcc8cfa"
      }
    }
  }
}
